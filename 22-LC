class Solution {
    public List<List<Integer>> subsets(int[] nums) {
        List<List<Integer>> result=new ArrayList<>();
        solve(0,nums,result,new ArrayList<>());
        return result;
    }

    public void solve(int idx,int[]arr,List<List<Integer>> result,List<Integer> curr){
        if (idx == arr.length) {result.add(new ArrayList<>(curr));return;}

        curr.add(arr[idx]);
        solve(idx+1,arr,result,curr);
        curr.remove(curr.size()-1);
        solve(idx+1,arr,result,curr);

    }
}
